{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "improvement-loop findings file",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "claim", "category", "evidence", "severity", "reach", "effort", "removes_complexity"],
        "properties": {
          "id": {"type": "string", "description": "unique within the file, e.g. ARCH-3"},
          "role": {"type": "string", "description": "the critic role that raised it"},
          "claim": {"type": "string", "minLength": 1},
          "category": {"enum": ["correctness", "security", "user_value", "simplicity"]},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["file", "line", "quote"],
              "properties": {
                "file": {"type": "string", "description": "path relative to the project root"},
                "line": {"type": "integer", "minimum": 1},
                "quote": {"type": "string", "minLength": 1, "description": "exact text on that line (or within 2 lines)"}
              }
            }
          },
          "severity": {"type": "integer", "minimum": 1, "maximum": 5},
          "reach": {"type": "integer", "minimum": 1, "maximum": 5},
          "effort": {"type": "integer", "minimum": 1, "maximum": 5},
          "removes_complexity": {"type": "boolean"},
          "verdict": {"enum": ["unverified", "true", "partly", "false", "not_checkable"]},
          "root_cause": {"type": "string"},
          "fix_hint": {"type": "string"},
          "notes": {"type": "string"},
          "fingerprint": {"type": "string"},
          "verified_by": {"type": "string"},
          "evidence_ok": {"type": "boolean"}
        }
      }
    }
  }
}
